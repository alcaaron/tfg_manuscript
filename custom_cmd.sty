\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mycommands}[2026/02/15 Custom commands]

% packages
\RequirePackage{textcomp}
\RequirePackage{graphicx}
\RequirePackage{subcaption}

% custom commands
\newcommand{\tcmp}[1]{\textlangle #1\textrangle}

\newcommand{\img}[4]{%
    \begin{figure}[ht]
        \begin{center}
            \includegraphics[width=#3\textwidth]{#1} \\
            \caption{#2}
            \label{fig:#4}
        \end{center}
    \end{figure}
}

\newcommand{\imgAndTrim}[5]{%
    \begin{figure}[ht]
        \begin{center}
            \includegraphics[
                width=#3\textwidth,
                trim={#5},
                clip]
            {#1} \\
            \caption{#2}
            \label{fig:#4}
        \end{center}
    \end{figure}
}

\newcommand{\imgtwo}[6]{%
    \begin{figure}[ht]
        \centering
        \begin{subfigure}[b]{0.45\textwidth}
            \centering
            \includegraphics[width=\textwidth, height=12cm, keepaspectratio=true]{#1}
            \caption{#2}
            \label{fig:#3}
        \end{subfigure}
        \hspace{0.5cm}
        \begin{subfigure}[b]{0.45\textwidth}
            \centering
            \includegraphics[width=\textwidth, height=12cm, keepaspectratio=true]{#4}
            \caption{#5}
            \label{fig:#6}
        \end{subfigure}
    \end{figure}
}

